            <div class="card mt15">
                <div class="card-content">
                    <p>
                        選択したデータ項目は、国土数値情報　行政区域データ　です。
                    </p>
                </div>
            </div>
            <table class="mb30 responsive-table dataTables">
                <thead>
                    <tr>
                        <th class="txtCenter">地域</th>
                        <th class="txtCenter">測地系</th>
                        <th class="txtCenter">年</th>
                        <th class="txtCenter">ファイル容量</th>
                        <th class="txtCenter">ファイル名</th>
                        <th class="txtCenter">ダウンロード</th>
                        <th class="txtCenter  style=" width:fit-content""="">一括DL
                            <a class="Select_part tooltipped" style="cursor:pointer;position:relative" data-position="top" data-tooltip="全てのデータを選択">
                                <label class="chkLabel-front">
                                    <input type="checkbox" class="filled-in select center-align" disabled="disabled" checked="checked">
                                    <span></span>
                                </label>
                                <label class="chkLabel-front chkLabel-back">
                                    <input type="checkbox" class="filled-in blank center-align" disabled="disabled" checked="checked">
                                    <span></span>
                                </label>
                            </a>
                            <a class="Clear_part tooltipped" style="cursor:pointer;position:relative;margin-left: 8px;" data-position="top" data-tooltip="全ての選択を解除">
                                <label class="chkLabel-front">
                                    <input type="checkbox" class="filled-in blank center-align" disabled="disabled">
                                    <span></span>
                                </label>

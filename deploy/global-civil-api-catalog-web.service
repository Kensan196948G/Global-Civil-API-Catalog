[Unit]
Description=Global Civil API Catalog WebUI (native python, port 49231)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/kensan/Projects/Mirai-DX-Project/Global-Civil-API-Catalog
ExecStart=/usr/bin/python3 web/server.py --host 0.0.0.0 --port 49231 --port-lock-file deploy/PORT.lock
Restart=always
RestartSec=5

[Install]
WantedBy=default.target

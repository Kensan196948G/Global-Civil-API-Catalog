SERVICE_NAME=global-civil-api-catalog-web
IMAGE_NAME=global-civil-api-catalog-web:local
HOST_PORT=49231
CONTAINER_PORT=8080

# PUBLIC_HOST: systemd unit / docker-compose のどちらからも参照されない記録専用の値。
# server.py の既定 bind を 127.0.0.1 化し(#38)、docker-compose の ports も
# "127.0.0.1:49231:8080" に限定した後は、LAN 内の他端末からこの IP への直接
# HTTP アクセスは想定しない。外部公開経路は deploy/cloudflare/ の Cloudflare
# Tunnel 経由のみ。
PUBLIC_HOST=192.168.0.185

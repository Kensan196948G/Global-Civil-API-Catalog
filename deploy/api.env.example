# api_v1 (FastAPI) 環境変数テンプレート — このファイルへ実値を書かない。
# 実ファイルの置き場所(Git 管理外):
#   Linux:   ~/.config/global-civil-api-catalog/api.env   (chmod 600)
#   Windows: %APPDATA%\global-civil-api-catalog\api.env   (ACL を自ユーザーのみに限定)
# 値は Neon / Entra ID の各管理画面から取得する。

# Neon PostgreSQL 接続文字列(必須)
CATALOG_DATABASE_URL=

# Entra ID OIDC(編集・承認 UI のログインに必須。設定手順: docs/entra-id-setup.md)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# ブラウザから見た「UI の公開オリジン」(必須)。
# CSRF Origin 検査・OIDC リダイレクト・Secure Cookie 判定に使われるため、
# api_v1 自身(:49232)ではなく UI のオリジンを設定すること。
# 未設定だと既定値 http://localhost:49232 と比較され、UI(:49231)からの書込が全て 403 になる。
#   本番:  https://api.mirai-dx-platform.com
#   LAN:   http://192.168.0.185:49231
CATALOG_BASE_URL=
